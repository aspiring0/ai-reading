# ===========================================
# AI Reading Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in values

# --- Application ---
ENV=development

# --- Database (PostgreSQL) ---
# Docker: use service name "postgres" as host
# Local: use "localhost" as host
DATABASE_URL=postgresql+asyncpg://aireading:aireading_dev@localhost:5432/ai_reading
POSTGRES_USER=aireading
POSTGRES_PASSWORD=aireading_dev
POSTGRES_DB=ai_reading

# --- Redis ---
# Docker: use mapped port (default 6379, change if port conflicts)
REDIS_PORT=6379
REDIS_URL=redis://localhost:${REDIS_PORT:-6379}/0

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret

# --- LLM (OpenAI-compatible API) ---
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# --- CORS ---
# Comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
